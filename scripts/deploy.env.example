# Server-only deployment settings for /etc/resend/deploy.env.
# This file contains no application secrets. Do not commit the real file.

# Required: exact names reported by `pm2 jlist` for the live applications.
RESEND_FRONTEND_PM2_NAME='REPLACE_WITH_DISCOVERED_FRONTEND_PM2_NAME'
RESEND_BACKEND_PM2_NAME='REPLACE_WITH_DISCOVERED_BACKEND_PM2_NAME'

# Optional: set only if the live listeners do not use these defaults.
# RESEND_FRONTEND_PORT=3000
# RESEND_BACKEND_PORT=3010

# Optional: these defaults describe the supported release layout.
# RESEND_REPOSITORY_DIR='/var/www/Resend'
# RESEND_RELEASES_DIR='/var/www/Resend/.releases'
# RESEND_CURRENT_DIR='/var/www/Resend/current'
# RESEND_SHARED_DIR='/var/www/Resend/.deploy-shared'
# RESEND_FRONTEND_ENV_FILE='/var/www/Resend/.deploy-shared/frontend.env'
# RESEND_BACKEND_ENV_FILE='/var/www/Resend/.deploy-shared/backend.env'
# RESEND_SESSIONS_DIR='/var/www/Resend/.deploy-shared/sessions'
